<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- Load Tailwind CSS for modern styling -->
	<script src="https://cdn.tailwindcss.com"></script>
	<title><%= title %></title>
</head>
<body class="bg-gray-100 font-sans antialiased">

	<div class="container mx-auto max-w-lg p-6 my-10">
		<div class="bg-white p-8 rounded-lg shadow-lg text-center">

			<!-- This title is passed from server.js: "Submission Successful" -->
			<h1 class="text-3xl font-bold mb-4 text-green-600"><%= title %></h1>

			<!-- This message is passed from server.js -->
			<p class="text-gray-700 text-lg mb-4"><%= message %></p>

			<!-- This userId is passed from the database result -->
			<p class="text-gray-600">New User ID: <span class="font-medium text-gray-900"><%= userId %></span></p>

			<div class="mt-8">
				<!-- This link takes the user back to the main form page -->
				<a href="/"
				   class="inline-block py-2 px-6 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
				   Add Another User
				</a>
			</div>

		</div>
	</div>

</body>
</html>