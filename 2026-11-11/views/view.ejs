<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<script src="https://cdn.tailwindcss.com"></script>
	<title><%= title %></title>
</head>
<body class="bg-gray-100 font-sans antialiased">

	<div class="container mx-auto max-w-4xl p-6 my-10">
		<div class="bg-white p-8 rounded-lg shadow-lg">

			<h1 class="text-3xl font-bold mb-6 text-center text-gray-800"><%= title %></h1>

			<!-- Navigation links -->
			<div class="mb-6 flex justify-center space-x-4">
				<a href="/"
				   class="inline-block py-2 px-6 border border-indigo-600 rounded-md shadow-sm text-sm font-medium text-indigo-600 bg-white hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
				   Back to Form
				</a>
			</div>

			<!-- Check if there is any data to display -->
			<% if (people && people.length > 0) { %>
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Name</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Name</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Age</th>
								<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							<!-- Loop through each person in the 'people' array -->
							<% people.forEach(person => { %>
								<tr>
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= person.id %></td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= person.first_name %></td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= person.last_name %></td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= person.age %></td>
									<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= person.email %></td>
								</tr>
							<% }) %>
						</tbody>
					</table>
				</div>
			<% } else { %>
				<!-- Show this message if the 'people' array is empty -->
				<p class="text-center text-gray-500">No data found in the database.</p>
			<% } %>

		</div>
	</div>

</body>
</html>